# Copy to .env and fill in. Never commit .env.
PORT=5000
MONGO_URI=
JWT_SECRET=
NODE_ENV=development
CLIENT_URL=http://localhost:5173
EMAIL_ASSET_BASE=
VITE_API_URL=
SERVER_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Primary transactional email service
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Legacy providers (used only when Cloudflare is not configured or explicitly selected)
UNOSEND_API_KEY=
# Backup email provider, used automatically when Unosend fails
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mysterymansion.app
# Set to eu for EU-hosted Mailgun domains
MAILGUN_REGION=

BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_PUBLIC_URL_BASE=

GOOGLE_CLIENT_ID=
# Not used by the current ID-token sign-in flow
GOOGLE_CLIENT_SECRET=
